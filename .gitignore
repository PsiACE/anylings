# Secrets and isolated state: never committed
*.pub
*.key
*.decrypted~*.yaml
/.local/
/age.key
/argo-webhook-token.txt
/cloudflare-tunnel.json
/deploy.key
/deploy.key.pub
# Template config files
/cluster.toml
# Bootstrap render artifacts may contain sensitive material; never committed
/bootstrap/manifests/
# Kubernetes
kubeconfig
# Python
__pycache__/
*.py[cod]
# Misc.
.claude/
.private/
.venv/
.DS_Store
# OpenTofu provider caches, local state and saved plans
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json

# Rendered chart output produced by bootstrap.sh render; never committed
/manifests/
