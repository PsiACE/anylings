{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Argocd": {
      "additionalProperties": false,
      "properties": {
        "chart_version": {
          "default": "10.14.0",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Chart Version",
          "type": "string"
        },
        "namespace": {
          "default": "argo-system",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "title": "Argocd",
      "type": "object"
    },
    "Ingress": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "none",
          "enum": ["none", "cloudflare-tunnel"],
          "title": "Mode",
          "type": "string"
        },
        "tunnel_token_file": {
          "default": "",
          "title": "Tunnel Token File",
          "type": "string"
        }
      },
      "title": "Ingress",
      "type": "object"
    },
    "Magpie": {
      "additionalProperties": false,
      "properties": {
        "config_claim": {
          "default": "",
          "title": "Config Claim",
          "type": "string"
        }
      },
      "title": "Magpie",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(https?://|git://|ssh://git@)[^/]+/.+$",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "known_hosts": {
          "default": "",
          "title": "Known Hosts",
          "type": "string"
        }
      },
      "required": ["url"],
      "title": "Repository",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "argocd": {
      "$ref": "#/$defs/Argocd",
      "default": {
        "chart_version": "10.14.0",
        "namespace": "argo-system"
      }
    },
    "ingress": {
      "$ref": "#/$defs/Ingress",
      "default": {
        "mode": "none",
        "tunnel_token_file": ""
      }
    },
    "magpie": {
      "$ref": "#/$defs/Magpie",
      "default": {
        "config_claim": ""
      }
    }
  },
  "required": ["repository"],
  "title": "cluster.toml",
  "type": "object"
}
