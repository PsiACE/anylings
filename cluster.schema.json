{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Agents": {
      "additionalProperties": false,
      "properties": {
        "image_repository": {
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$",
          "title": "Image Repository",
          "type": "string"
        },
        "image_tag": {
          "default": "0.1.8",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
          "title": "Image Tag",
          "type": "string"
        },
        "storage_existing_claim": {
          "default": "",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "title": "Storage Existing Claim",
          "type": "string"
        }
      },
      "required": ["image_repository"],
      "title": "Agents",
      "type": "object"
    },
    "Argocd": {
      "additionalProperties": false,
      "properties": {
        "chart_version": {
          "default": "10.14.0",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Chart Version",
          "type": "string"
        },
        "namespace": {
          "default": "argo-system",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "title": "Argocd",
      "type": "object"
    },
    "Ingress": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "none",
          "enum": ["none", "cloudflare-tunnel"],
          "title": "Mode",
          "type": "string"
        },
        "tunnel_token_file": {
          "default": "",
          "title": "Tunnel Token File",
          "type": "string"
        }
      },
      "title": "Ingress",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(https?://|git://|ssh://git@)[^/]+/.+$",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "known_hosts": {
          "default": "",
          "title": "Known Hosts",
          "type": "string"
        }
      },
      "required": ["url"],
      "title": "Repository",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "argocd": {
      "$ref": "#/$defs/Argocd",
      "default": {
        "chart_version": "10.14.0",
        "namespace": "argo-system"
      }
    },
    "ingress": {
      "$ref": "#/$defs/Ingress",
      "default": {
        "mode": "none",
        "tunnel_token_file": ""
      }
    },
    "agents": {
      "anyOf": [
        {
          "$ref": "#/$defs/Agents"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": ["repository"],
  "title": "cluster.toml",
  "type": "object"
}
