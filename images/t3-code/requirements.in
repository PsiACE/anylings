# The source pins for the toolchain in the image. requirements.txt is the
# resolved, hash-constrained lock generated from this file with:
#   uv pip compile --python-version 3.13 --generate-hashes --no-header \
#       --no-annotate requirements.in -o requirements.txt
# The `app` extra is what installs Bub's command line; without it `bub` exits
# with a message saying so.
bub[app]==0.6.1
