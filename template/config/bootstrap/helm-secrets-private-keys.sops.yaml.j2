---
# Credentials for the Argo CD repository secret. Encrypted as a whole file:
# an encrypted_regex on data/stringData left these values in plaintext.
apiVersion: v1
kind: Secret
metadata:
  name: helm-secrets-private-keys
  namespace: #{ argocd.namespace }#
stringData:
  key.txt: |
    #{ age_key('private') }#
