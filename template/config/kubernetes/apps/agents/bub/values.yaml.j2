#% if agents %#
# Helm values for the Bub agent runtime, rendered into the published Git tree
# and consumed by the shared app-template ApplicationSet entry.
#
# The workload is the combined platform image built from `images/bub`: the Bub
# CLI and its ACP server, plus the T3 Code web server on its upstream release
# binary as the browser-facing surface. The image tag names both, so neither is
# implied by the other. Nothing here selects a model or a vendor: provider
# sign-in and model choice happen inside the instance at runtime.
controllers:
  bub:
    # The combined runtime keeps one SQLite database and one set of provider
    # session state, so a second replica would corrupt it. Scaling out is a
    # separate decision that needs external state first.
    replicas: 1
    strategy: Recreate
    containers:
      app:
        image:
          repository: #{ agents.image_repository }#
          tag: #{ agents.image_tag | tojson }#
#% if agents.image_digest %#
          # Pinned to the digest the publisher recorded, so a moved tag cannot
          # change what this cluster runs.
          digest: #{ agents.image_digest | tojson }#
#% endif %#
        # The runtime creates WORKDIR as root before the entrypoint starts.
        # Use the existing tmp volume so it cannot pre-create a root-owned
        # workspace inside the writable home volume; the entrypoint creates it.
        workingDir: /tmp
        env:
          # State and workspace paths come from the image; the one mount point
          # below covers both. The bind address and port are repeated here
          # because the Service publishes this exact port, and a change to one
          # without the other would silently break the route.
          #
          # These stay T3CODE_*: they are the T3 web server's own contract and
          # the image's `t3` binary reads them. Renaming them here would only
          # break startup; the platform-facing name of this workload is Bub.
          T3CODE_HOST: 0.0.0.0
          T3CODE_PORT: "3773"
#% if agents.gateway_secret %#
          BUB_MODEL: magpie:group/deepseek-flash
          BUB_MAGPIE_API_BASE: http://magpie.gateways.svc.cluster.local:3425/v1
          BUB_MAGPIE_API_KEY:
            valueFrom:
              secretKeyRef:
                name: bub-magpie-gateway
                key: gateway-key
          BUB_COMPLETION_ARGS: '{"reasoning_effort":"high"}'
#% endif %#
        ports:
          - name: http
            containerPort: 3773
            protocol: TCP
        probes:
          # T3 answers this endpoint with 200 while its auth subsystem serves;
          # the body says the caller is unauthenticated, which is the expected
          # state here, so only the status code is asserted.
          readiness:
            enabled: true
            type: HTTP
            path: /api/auth/session
            port: http
            spec:
              initialDelaySeconds: 10
              periodSeconds: 20
              timeoutSeconds: 5
              failureThreshold: 3
          # Liveness deliberately does not restart on the same signal: the auth
          # endpoint stays up while a provider is misconfigured, and a restart
          # would not fix that.
          liveness:
            enabled: true
            type: HTTP
            path: /api/auth/session
            port: http
            spec:
              initialDelaySeconds: 30
              periodSeconds: 60
              timeoutSeconds: 5
              failureThreshold: 5
        securityContext:
          allowPrivilegeEscalation: false
          # The image already runs as this account; repeating it here keeps the
          # contract visible at the deployment, where an operator changes it.
          readOnlyRootFilesystem: true
          capabilities: { drop: ["ALL"] }
        resources:
          requests:
            cpu: 100m
            memory: 512Mi
          limits:
            # The web server plus a provider CLI it launches. Raising it is a
            # deployment decision, not something this template infers.
            memory: 2Gi
defaultPodOptions:
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    runAsGroup: 65532
    # A mounted claim is created by the kubelet as root. Without fsGroup the
    # nonroot process could not write its own state directory.
    fsGroup: 65532
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile:
      type: RuntimeDefault
persistence:
  # One writable root carries T3's database, the project checkouts it references
  # and the agent's own $HOME state (Bub keeps its tapes under ~/.bub), so it is
  # mounted at /home/t3 itself. That path is the image's home and the layout of
  # the existing claim, so it stays even though the workload is called Bub.
  # Mounting leaf directories instead would move the volume's internal layout
  # (`<volume>/.t3`, `<volume>/workspace`) and strand the state already stored on
  # an existing claim, and it would leave $HOME read-only so the agent could not
  # create its own state directory.
  #
  # A fresh volume root belongs to root, so the pod sets fsGroup below and the
  # image's entrypoint creates its own subdirectories once it can write there.
#% if agents.storage_existing_claim %#
  home:
    type: persistentVolumeClaim
    existingClaim: #{ agents.storage_existing_claim | tojson }#
    globalMounts:
      - path: /home/t3
#% else %#
  # emptyDir is the default because this template does not choose a StorageClass
  # or buy storage. State is lost when the pod is replaced; see the README.
  home:
    type: emptyDir
    globalMounts:
      - path: /home/t3
#% endif %#
  tmp:
    type: emptyDir
    globalMounts:
      - path: /tmp
service:
  app:
    # Cluster-internal only: the runtime's HTTP/WebSocket API and the provider
    # sessions it runs never leave the cluster network by default. Publishing it
    # is a separate ingress decision that must keep the web server's own
    # authentication on.
    type: ClusterIP
    ports:
      http:
        port: 3773
        primary: true
#% endif %#
