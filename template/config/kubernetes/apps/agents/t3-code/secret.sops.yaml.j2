#% if agents and agents.gateway_secret %#
---
# The gateway key this runtime presents to Magpie, read from the file named by
# agents.gateway_secret. It is the same value Magpie recorded in its own
# caller-keys.json, so the two must be provisioned from one source.
apiVersion: v1
kind: Secret
metadata:
  name: t3-code-magpie-gateway
  namespace: agents
  labels:
    app.kubernetes.io/part-of: anylings
type: Opaque
stringData:
  gateway-key: #{ gateway_key() | tojson }#
#% endif %#
