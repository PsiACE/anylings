#% if observability.enabled %#
---
apiVersion: v1
kind: Service
metadata:
  name: otel-kubelet
  namespace: observability
spec:
  type: ClusterIP
  clusterIP: None
  selector:
    app.kubernetes.io/instance: otel-kubelet
    app.kubernetes.io/name: opentelemetry-collector
    component: agent-collector
  ports:
    - name: metrics
      port: 8889
      targetPort: metrics
      protocol: TCP
#% endif %#
