#% if observability.enabled %#
---
# Dashboards served by vmui's "Dashboards" tab. The ApplicationSet installs
# this ConfigMap with the VictoriaMetrics application, and
# -vmui.customDashboardsPath=/dashboards reads it at page load.
#
# Every panel queries a metric ingested by this slice: VictoriaMetrics, Gatus,
# the per-node kubelet collectors and kube-state-metrics. None of these are
# placeholders, and none depend on a sample that only appears under load
# (error counters are read as rates, which return 0 rather than nothing).
apiVersion: v1
kind: ConfigMap
metadata:
  name: victoria-metrics-dashboards
  namespace: observability
  annotations:
    # This ConfigMap comes from the same Application's Git source while the
    # Deployment comes from its chart source. A negative wave applies it first,
    # so the pod never starts against a missing dashboard volume.
    argocd.argoproj.io/sync-wave: "-1"
data:
  nodes-workloads.json: |
    {
      "title": "Nodes and workloads",
      "rows": [
        {
          "title": "Usage and workload state",
          "panels": [
            {
              "title": "Node CPU (cores)",
              "width": 6,
              "expr": [
                "sum by (node) (k8s_node_cpu_usage)"
              ]
            },
            {
              "title": "Node working set (bytes)",
              "width": 6,
              "expr": [
                "sum by (node) (k8s_node_memory_working_set_bytes)"
              ]
            },
            {
              "title": "Node filesystem used (bytes)",
              "width": 6,
              "expr": [
                "max by (node) (k8s_node_filesystem_usage_bytes)"
              ]
            },
            {
              "title": "Pod CPU (cores)",
              "width": 6,
              "expr": [
                "sum by (namespace,pod) (k8s_pod_cpu_usage)"
              ]
            },
            {
              "title": "Pod working set (bytes)",
              "width": 6,
              "expr": [
                "sum by (namespace,pod) (k8s_pod_memory_working_set_bytes)"
              ]
            },
            {
              "title": "Container working set (bytes)",
              "width": 6,
              "expr": [
                "sum by (namespace,pod,container) (container_memory_working_set_bytes)"
              ]
            },
            {
              "title": "Pod working set / requested memory",
              "width": 6,
              "expr": [
                "sum by (namespace,pod) (k8s_pod_memory_working_set_bytes) / on(namespace,pod) sum by (namespace,pod) (kube_pod_container_resource_requests{resource=\"memory\"})"
              ]
            },
            {
              "title": "Controller working set (bytes)",
              "width": 6,
              "expr": [
                "sum by (namespace,owner_kind,owner_name) (sum by (namespace,pod) (k8s_pod_memory_working_set_bytes) * on(namespace,pod) group_left(owner_kind,owner_name) kube_pod_owner{owner_is_controller=\"true\"})"
              ]
            },
            {
              "title": "Container restarts (cumulative)",
              "width": 6,
              "expr": [
                "sum by (namespace,pod) (kube_pod_container_status_restarts_total)"
              ]
            },
            {
              "title": "Last termination was OOM (1=yes)",
              "width": 6,
              "expr": [
                "max by (namespace,pod) (kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"})"
              ]
            },
            {
              "title": "Unscheduled Pods (1=yes)",
              "width": 6,
              "expr": [
                "max by (namespace,pod) (kube_pod_status_scheduled{condition=\"false\"})"
              ]
            },
            {
              "title": "Ready Pods (1=yes)",
              "width": 6,
              "expr": [
                "max by (namespace,pod) (kube_pod_status_ready{condition=\"true\"})"
              ]
            },
            {
              "title": "Deployment unavailable replicas",
              "width": 6,
              "expr": [
                "kube_deployment_spec_replicas - on(namespace,deployment) kube_deployment_status_replicas_available"
              ]
            },
            {
              "title": "Requested CPU (cores)",
              "width": 6,
              "expr": [
                "sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\"})"
              ]
            },
            {
              "title": "Pod volume available fraction",
              "width": 6,
              "expr": [
                "max by (namespace,pod,volume) (k8s_volume_available_bytes) / max by (namespace,pod,volume) (k8s_volume_capacity_bytes)"
              ],
              "description": "Available fraction of each volume; not provisioned disk headroom."
            },
            {
              "title": "Deployment working set (bytes)",
              "width": 6,
              "expr": [
                "sum by (namespace,workload) (sum by (namespace,pod) (k8s_pod_memory_working_set_bytes) * on(namespace,pod) group_left(replicaset) label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\",owner_is_controller=\"true\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.+)\") * on(namespace,replicaset) group_left(workload) label_replace(kube_replicaset_owner{owner_kind=\"Deployment\",owner_is_controller=\"true\"}, \"workload\", \"$1\", \"owner_name\", \"(.+)\"))"
              ]
            }
          ]
        }
      ]
    }
  platform-overview.json: |
    {
      "title": "Platform overview",
      "rows": [
        {
          "title": "Scrape health",
          "panels": [
            {
              "title": "Targets up",
              "width": 6,
              "unit": "short",
              "expr": ["sum(up)", "count(up)"],
              "alias": ["up", "configured"]
            },
            {
              "title": "Scrapes failing",
              "width": 6,
              "unit": "short",
              "expr": ["sum(rate(vm_promscrape_scrapes_failed_total[5m]))"]
            }
          ]
        },
        {
          "title": "Ingestion",
          "panels": [
            {
              "title": "Rows inserted per second",
              "width": 6,
              "expr": ["sum(rate(vm_rows_inserted_total[5m]))"]
            },
            {
              "title": "Rows rejected by cardinality limits",
              "width": 6,
              "expr": ["sum(rate(vm_rows_ignored_total[5m])) by (reason)"],
              "alias": ["{{reason}}"]
            }
          ]
        }
      ]
    }
  storage-budget.json: |
    {
      "title": "Storage budget",
      "rows": [
        {
          "title": "Active series and disk",
          "panels": [
            {
              "title": "Active series",
              "width": 6,
              "unit": "short",
              "expr": ["sum(vm_cache_entries{type=\"storage/hour_metric_ids\"})"]
            },
            {
              "title": "Stored data",
              "width": 6,
              "unit": "MB",
              "expr": ["sum(vm_data_size_bytes) / 1024 / 1024"]
            }
          ]
        },
        {
          "title": "Headroom",
          "panels": [
            {
              "title": "Free disk in the data volume",
              "width": 6,
              "unit": "MB",
              "expr": ["vm_free_disk_space_bytes / 1024 / 1024"]
            },
            {
              "title": "Process memory",
              "width": 6,
              "unit": "MB",
              "expr": ["process_resident_memory_bytes{job=\"victoria-metrics\"} / 1024 / 1024"]
            }
          ]
        }
      ]
    }
  probe-status.json: |
    {
      "title": "Probe status",
      "rows": [
        {
          "title": "Gatus probe results",
          "panels": [
            {
              "title": "Probe success (1 = passing)",
              "width": 6,
              "unit": "short",
              "expr": ["gatus_results_endpoint_success"],
              "alias": ["{{name}}"]
            },
            {
              "title": "Probe duration",
              "width": 6,
              "unit": "s",
              "expr": ["gatus_results_duration_seconds"],
              "alias": ["{{name}}"]
            }
          ]
        },
        {
          "title": "Probe failures",
          "panels": [
            {
              "title": "Failed checks per second",
              "width": 6,
              "expr": ["sum(rate(gatus_results_total{success=\"false\"}[10m])) by (name)"],
              "alias": ["{{name}}"]
            },
            {
              "title": "Slow queries rejected",
              "width": 6,
              "expr": ["sum(rate(vm_slow_queries_total[5m]))"]
            }
          ]
        }
      ]
    }
#% endif %#
