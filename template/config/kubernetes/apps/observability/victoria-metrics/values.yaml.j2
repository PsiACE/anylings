#% if observability.enabled %#
---
# Single-node VictoriaMetrics: the platform's metric store. It scrapes the
# targets below itself, so no vmagent, Prometheus operator or extra store is
# deployed alongside it.
#
# Retention is an explicit 7d, but that is not physical erasure after seven
# days. VictoriaMetrics prunes whole per-month partitions, and its own docs say
# background merges may never run for a month that stopped receiving data, so
# old bytes can outlive the window. The 7d value is a query/storage target.
# Audit records need a separate store with its own <=30d policy; they do not
# belong here.
# Operator-style naming gives the chart a real Service named `victoria-metrics`
# instead of the legacy `-server` suffix, and it is the only naming mode this
# chart version supports for a Deployment.
useLegacyNaming: false
rbac:
  # The chart would otherwise create a cluster-scoped ClusterRole that may read
  # Nodes, Services, Endpoints, Pods and Ingresses. This deployment only scrapes
  # static and DNS-discovered in-cluster targets, so it needs no Kubernetes API
  # access and creates no cluster RBAC.
  create: false
serviceAccount:
  automountToken: false
server:
  # A Deployment, not the chart's default StatefulSet: this instance keeps no
  # claim, and a Deployment expresses "one replaceable pod" without a
  # volumeClaimTemplate.
  mode: deployment
  fullnameOverride: victoria-metrics
  retentionPeriod: "7d"
  # Never provision a claim automatically. The chart's default is a 16Gi PVC,
  # which on a cloud backend would silently bill a volume nothing here owns.
  # An emptyDir keeps the pod writable where no storage class was chosen, and
  # its sizeLimit bounds the disk the container can consume.
  #
  # To keep metrics across a reschedule, point this at a claim the operator
  # created deliberately (`existingClaim`) instead of enabling provisioning.
  persistentVolume:
    enabled: false
  emptyDir:
    sizeLimit: 2Gi
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      # Caps the whole container. The flags below bound internal caches and
      # ingestion cardinality only, so they cannot replace a memory limit.
      memory: 768Mi
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop: ["ALL"]
  podSecurityContext:
    runAsNonRoot: true
    # The image ships its own nonroot account, and fsGroup keeps a kubelet-made
    # storage volume writable by that account.
    runAsUser: 65534
    runAsGroup: 65534
    fsGroup: 65534
    seccompProfile:
      type: RuntimeDefault
  extraArgs:
    # Disable the chart's env-flag mapping so an accidental VM_* environment
    # variable cannot override the limits set here.
    envflag.enable: false
    loggerFormat: json
    # Lets vmui and /metrics show this instance's own health.
    selfScrapeInterval: 30s
    memory.allowedBytes: "268435456"
    # Bounded label and churn budgets: over-budget series are counted in
    # vm_rows_ignored_total instead of growing the store without limit.
    maxLabelsPerTimeseries: 30
    storage.maxHourlySeries: 10000
    storage.maxDailySeries: 20000
    storage.minFreeDiskSpaceBytes: 256MiB
    search.maxQueryDuration: 30s
    # Serve the platform dashboards from the ConfigMap mounted below. Without
    # this flag vmui shows only its query tab.
    vmui.customDashboardsPath: /dashboards
  extraVolumes:
    - name: dashboards
      configMap:
        name: victoria-metrics-dashboards
  extraVolumeMounts:
    - name: dashboards
      mountPath: /dashboards
      readOnly: true
  scrape:
    enabled: true
    config:
      global:
        # One modest interval. This slice monitors the platform; sub-minute
        # resolution would only multiply stored samples.
        scrape_interval: 30s
        scrape_timeout: 10s
      scrape_configs:
        - job_name: victoria-metrics
          static_configs:
            - targets:
                - 127.0.0.1:8428
        - job_name: gatus
          static_configs:
            - targets:
                - gatus.observability.svc.cluster.local:8080
        - job_name: kubelet
          # Resolve every ready Pod IP from the headless Service, not a single
          # load-balanced ClusterIP. No Kubernetes API token/RBAC in the store.
          dns_sd_configs:
            - names: [otel-kubelet.observability.svc.cluster.local]
              type: A
              port: 8889
          sample_limit: 5000
          metric_relabel_configs:
            - action: labelmap
              regex: k8s_(namespace|pod|container|node|volume)_name
              replacement: $1
            - action: labeldrop
              regex: k8s_.*|service_.*|telemetry_.*
        - job_name: kube-state-metrics
          static_configs:
            - targets: [kube-state-metrics.observability.svc.cluster.local:8080]
          sample_limit: 5000
          metric_relabel_configs:
            - action: labeldrop
              regex: uid
        - job_name: otel-events
          # The collector's own counters. `..._filter_logs_filtered` is the
          # drop counter: it counts discarded records without repeating any
          # field from them, so a privacy decision is observable, not silent.
          static_configs:
            - targets: [otel-events.observability.svc.cluster.local:8888]
          sample_limit: 2000
        - job_name: victoria-logs
          # The log store's own health and ingestion counters.
          static_configs:
            - targets: [victoria-logs.observability.svc.cluster.local:9428]
          sample_limit: 2000
        - job_name: cloudflare-tunnel
          # The public frontdoor's own counters, from cloudflared's metrics
          # listener. These are real request aggregates: every request the
          # tunnel proxies increments `cloudflared_tunnel_total_requests`, and
          # `cloudflared_tunnel_response_by_code` counts them per status class.
          #
          # What this does NOT give you: request paths, queries, client
          # addresses, user agents or bodies. cloudflared never exports them, so
          # the aggregate is bounded by construction -- there is no field to
          # leak them into. `request_errors` counts proxy-to-origin failures,
          # which is the closest thing to a 5xx-class signal on this path.
          static_configs:
            - targets: [cloudflare-tunnel.network.svc.cluster.local:8080]
          sample_limit: 2000
          metric_relabel_configs:
            # Drop the identity labels the PINNED tunnel actually emits.
            #
            # The previous pattern named four labels (connIndex, ip, hostname,
            # tunnel_id) that appear nowhere in the exposition -- `connIndex` is
            # only a Go field name and a log field -- so it removed nothing while
            # reading as though it did. Measured against the repository pin
            # (cloudflared 2026.10.7), the identity-bearing labels are:
            #
            #   userHostname   the operator's public frontdoor hostname
            #   connection_id  one series per connector connection
            #   edge_location  the Cloudflare edge serving it
            #   rpcName        one series per registration RPC
            #
            # Each is deployment identity rather than an aggregate dimension, and
            # connection_id/rpcName grow with connection churn. Dropping them
            # cannot change any panel: the counters and histograms this slice
            # queries (`total_requests`, `response_by_code`, `request_errors`,
            # `ha_connections`, `concurrent_requests_per_tunnel`) carry no labels
            # at all beyond the scrape target, which the store adds itself.
            - action: labeldrop
              regex: (userHostname|connection_id|edge_location|rpcName)
service:
  # ClusterIP only. The chart makes a StatefulSet service headless; this is a
  # Deployment and an ordinary Service, and nothing here creates an Ingress or
  # a LoadBalancer.
  type: ClusterIP
#% endif %#
