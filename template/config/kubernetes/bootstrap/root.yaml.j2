---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: #{ argocd.namespace }#
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: #{ repository.url }#
    path: #{ repository_path('kubernetes/projects') }#
    targetRevision: #{ repository.branch }#
  destination:
    name: in-cluster
    namespace: #{ argocd.namespace }#
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
      allowEmpty: true
    retry:
      limit: 1
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
    syncOptions:
      - CreateNamespace=true
      - ApplyOutOfSyncOnly=true
      - ServerSideApply=true
      - PruneLast=true
      - RespectIgnoreDifferences=true
  ignoreDifferences:
    - group: argoproj.io
      kind: Application
      jsonPointers:
        - /status
