---
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: kubernetes
  namespace: #{ argocd.namespace }#
  annotations:
    argocd.argoproj.io/sync-wave: "-10"
spec:
  # Only Applications created in the Argo namespace can use this project.
  # This is a trusted platform repository, not a tenant security boundary.
  sourceNamespaces:
    - #{ argocd.namespace }#
  # Only this repository and the pinned chart registries this template uses.
  sourceRepos:
    - #{ repository.url }#
    - ghcr.io/argoproj/argo-helm
    - ghcr.io/bjw-s-labs/helm
    - ghcr.io/stakater/charts
    #% if observability.enabled %#
    - ghcr.io/victoriametrics/helm-charts
    #% endif %#
    #% if spinkube.enabled %#
    - ghcr.io/spinframework/charts
    - quay.io/jetstack/charts
    #% endif %#
  destinations:
    - name: in-cluster
      namespace: "#{ argocd.namespace }#"
    # The shared model gateway lives in its own namespace so a public route and
    # its data volume are scoped to one application.
    - name: in-cluster
      namespace: gateways
    - name: in-cluster
      namespace: kube-system
    - name: in-cluster
      namespace: network
    #% if observability.enabled %#
    - name: in-cluster
      namespace: observability
    #% endif %#
    #% if agents %#
    # The agent runtime keeps its workspace and state in its own namespace,
    # separate from the shared gateway.
    - name: in-cluster
      namespace: agents
    #% endif %#
    #% if spinkube.enabled %#
    # The Spin feature keeps the operator, its executor and a sample app
    # together, because the operator resolves an executor in the app's own
    # namespace.
    - name: in-cluster
      namespace: spinkube
    #% endif %#
  # Permit the cluster-scoped kinds used by Argo and reloader, not provider
  # networking, Nodes or persistent storage resources.
  clusterResourceWhitelist:
    - group: ""
      kind: Namespace
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
    - group: rbac.authorization.k8s.io
      kind: ClusterRole
    - group: rbac.authorization.k8s.io
      kind: ClusterRoleBinding
    #% if spinkube.enabled %#
    # cert-manager and the Spin operator own admission webhooks. They are
    # cluster-scoped, so they need an explicit grant; nothing else is widened.
    - group: admissionregistration.k8s.io
      kind: MutatingWebhookConfiguration
    - group: admissionregistration.k8s.io
      kind: ValidatingWebhookConfiguration
    #% endif %#
